// Angel Bridge Foundation — data model (MVP)
// PostgreSQL (works locally and on hosts like Vercel/Neon/Supabase).
// Complex/variable-shape values (checkbox sets, answer snapshots) are stored as
// JSON-encoded strings to stay portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & sessions
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  emailVerified     Boolean  @default(false)
  verifyToken       String?
  passwordHash      String
  fullName          String
  phone             String
  dateOfBirth       DateTime?
  role              String   @default("user") // user | volunteer | admin
  deviceFingerprint String?                    // set client-side to detect multi-account abuse
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions     Session[]
  cases        Case[]
  testimonials Testimonial[]
  donations    Donation[]
  assignedCases Case[] @relation("AssignedVolunteer")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Help requests (cases)
// ---------------------------------------------------------------------------

model Case {
  id         String   @id @default(cuid())
  caseNumber String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  // Section — situation
  situationType   String
  description     String
  incidentAt      DateTime
  currentAddress  String
  currentPostcode String
  currentLat      Float?
  currentLng      Float?
  destinationAddress String
  gpsVerified     Boolean @default(false)
  inPilotArea     Boolean @default(false)

  // Section — needs & resources (JSON string arrays)
  needs       String @default("[]")
  needsOther  String?
  have        String @default("[]")

  // Section — safety
  isSafe       Boolean @default(true)
  unsafeReason String?
  isInjured    Boolean @default(false)
  hasOthers    Boolean @default(false)
  othersWith   String  @default("[]")

  // Section — existing help
  contactedHelp Boolean @default(false)
  contactedWho  String  @default("[]")
  waitingFor    String?
  estimatedWait String?

  // Section — resources
  moneyAvailable String?
  canBuyFood     Boolean @default(false)
  safeTonight    Boolean @default(false)

  // Section — how to identify the person on scene
  shareIdentity Boolean @default(true)
  carReg        String?
  surroundings  String?
  wearing       String?

  // Section — previous & verification
  previousHelp Boolean @default(false)
  idVerified   Boolean @default(false)

  // Consent to us calling 999 on their behalf if it becomes an emergency
  consentEmergency Boolean @default(false)

  // Scoring (auto)
  eligible            Boolean @default(false)
  eligibilityResult   String  @default("{}") // per-question outcome snapshot
  fraudRiskScore      Int     @default(0)
  vulnerabilityScore  Int     @default(0)
  priorityScore       Int     @default(0)
  riskBand            String  @default("Amber") // Green | Amber | Red
  pathway             String  @default("standard") // standard | enhanced | referral

  // Case management
  status             String  @default("Pending") // Pending | Approved | Declined | Escalated | Closed
  assignedVolunteerId String?
  assignedVolunteer   User?   @relation("AssignedVolunteer", fields: [assignedVolunteerId], references: [id])
  caseNotes          String  @default("")
  etaMinutes         Int?
  outcome            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    CaseEvent[]
  movements InventoryMovement[]
  incidentReport IncidentReport?
}

// ---------------------------------------------------------------------------
// Incident reports — completed by an Angel Bridge Foundation member after
// attending, with a feedback link sent to the assisted person.
// ---------------------------------------------------------------------------

model IncidentReport {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  completedByName  String @default("")
  completedByEmail String @default("")

  arrivedAt   DateTime?
  completedAt DateTime?

  summary       String  @default("") // what was found on arrival
  helpProvided  String  @default("[]") // JSON array of help types given
  suppliesGiven String  @default("") // free text list of items handed over
  outcome       String  @default("") // how the situation was resolved
  memberNotes   String  @default("")

  emergencyServicesCalled Boolean @default(false)
  emergencyServicesDetail String  @default("")

  status String @default("draft") // draft | completed

  // Feedback from the assisted person
  feedbackToken       String    @unique
  feedbackRating      Int?
  feedbackComment     String?
  feedbackSubmittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String   // created | assessed | assigned | dispatched | arrived | closed | note
  message   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Donations + inventory
// ---------------------------------------------------------------------------

model Donation {
  id          String   @id @default(cuid())
  donorName   String
  donorEmail  String
  amountPence Int
  tier        String?
  message     String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("recorded") // recorded (stub) | paid
  createdAt   DateTime @default(now())
}

model InventoryItem {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  zone         String
  unit         String   @default("unit")
  quantity     Int      @default(0)
  reorderLevel Int      @default(5)
  updatedAt    DateTime @updatedAt

  movements InventoryMovement[]
}

model InventoryMovement {
  id        String   @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Community: testimonials, volunteers, partners, sponsorships, fleet
// ---------------------------------------------------------------------------

model Testimonial {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String
  location   String   @default("Manchester")
  story      String
  rating     Int      @default(5)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Volunteer {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  phone        String
  postcode     String
  availability String
  skills       String   @default("")
  status       String   @default("pending") // pending | active | inactive
  hoursLogged  Int      @default(0)
  createdAt    DateTime @default(now())
}

model Partner {
  id          String   @id @default(cuid())
  orgName     String
  contactName String
  email       String
  phone       String
  partnerType String
  message     String   @default("")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Sponsorship {
  id          String   @id @default(cuid())
  type        String   // van | family | foodpack | hygiene | team
  sponsorName String
  email       String
  company     String?
  amountPence Int?
  message     String   @default("")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Vehicle {
  id        String   @id @default(cuid())
  name      String
  reg       String
  type      String   @default("Rapid Response")
  status    String   @default("available") // available | on_job | maintenance
  baseLat   Float?
  baseLng   Float?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String   @default("system")
  action     String
  target     String   @default("")
  detail     String   @default("")
  createdAt  DateTime @default(now())
}
