# Copy to .env and fill in.
#
# DATABASE_URL — a PostgreSQL connection string. Get a free one from Neon
# (https://neon.tech) or Supabase, or use Vercel Postgres. Example shape:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the site (used for email-verification links and payment redirects).
# Locally: http://localhost:3000  — In production: your deployed URL.
APP_URL="http://localhost:3000"

# Stripe secret key for donations (cards + Apple Pay + Google Pay via Stripe Checkout).
# Get it from https://dashboard.stripe.com/apikeys (starts with sk_test_ or sk_live_).
# If left blank, donations are recorded without taking a real payment.
STRIPE_SECRET_KEY=""

# Geofence for the Manchester pilot (city-centre centroid + radius in km).
PILOT_CENTER_LAT="53.4808"
PILOT_CENTER_LNG="-2.2426"
PILOT_RADIUS_KM="15"
